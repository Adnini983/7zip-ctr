# DumpKeysCTR.gm9 -- 7-Zip CTR key / material dumper (GodMode9 1.9+)
#
# Output on the SD card:
#   0:/gm9out/7zctr-keys/pub/     AES keys that are safe to publish
#   0:/gm9out/7zctr-keys/priv/    console-unique material -- NEVER upload
#   0:/gm9out/7zctr-keys/pubkey/  FIRM RSA-2048 moduli + pubkey.ini (public keys)
#
# Inputs:
#   * [K:] AESKEYDB  -- put aeskeydb.bin in the SD root and restart GodMode9
#   * [M:] MEMORY VIRTUAL -- boot9.bin / otp.mem / otp_dec.mem / nand_cid.mem
#     (used for the NAND device profile and for the FIRM public keys)
#
# Notes:
#   * All messages are ASCII on purpose: GodMode9's default font has no CJK
#     glyphs, so Chinese text would be rendered as garbage.
#   * mkdir takes no flags in GM9Script (the previous version used "mkdir -w",
#     which the parser rejects), and every mkdir is guarded with "if not exist".
#   * fget can read at most 127 bytes per call, so each 256-byte modulus is read
#     in three chunks (0x7F + 0x7F + 0x02) and written back with fset.

set PREVIEW_MODE "quick"

set OUT "0:/gm9out/7zctr-keys"
if not exist $[OUT]
  mkdir $[OUT]
end
if not exist $[OUT]/pub
  mkdir $[OUT]/pub
end
if not exist $[OUT]/priv
  mkdir $[OUT]/priv
end
if not exist $[OUT]/pubkey
  mkdir $[OUT]/pubkey
end

# ---------------------------------------------------------------
# [K:] check (aeskeydb.bin)
# ---------------------------------------------------------------
if not exist K:/
  echo "WARNING: [K:] AESKEYDB is not mounted."
  echo "Put aeskeydb.bin in the SD root and restart GodMode9"
  echo "if you also want the AES key folders (skipping that part)."
end

# A failed command aborts a GM9 script, so the whole [K:] part is skipped
# when the drive is not mounted (the pubkey part below must still run).
if exist K:/

# ---------------------------------------------------------------
# 1. Publishable AES keys (common keydata + already-public slots)
#    slot0x03 / 0x18 / 0x1B / 0x25 / 0x2C..0x3F
# ---------------------------------------------------------------
for K:/ slot0x03Key*.bin
 cp -w $[FORPATH] $[OUT]/pub/
next
for K:/ slot0x18Key*.bin
 cp -w $[FORPATH] $[OUT]/pub/
next
for K:/ slot0x1BKey*.bin
 cp -w $[FORPATH] $[OUT]/pub/
next
for K:/ slot0x25Key*.bin
 cp -w $[FORPATH] $[OUT]/pub/
next
for K:/ slot0x2CKey*.bin
 cp -w $[FORPATH] $[OUT]/pub/
next
for K:/ slot0x2DKey*.bin
 cp -w $[FORPATH] $[OUT]/pub/
next
for K:/ slot0x2EKey*.bin
 cp -w $[FORPATH] $[OUT]/pub/
next
for K:/ slot0x2FKey*.bin
 cp -w $[FORPATH] $[OUT]/pub/
next
for K:/ slot0x30Key*.bin
 cp -w $[FORPATH] $[OUT]/pub/
next
for K:/ slot0x31Key*.bin
 cp -w $[FORPATH] $[OUT]/pub/
next
for K:/ slot0x32Key*.bin
 cp -w $[FORPATH] $[OUT]/pub/
next
for K:/ slot0x33Key*.bin
 cp -w $[FORPATH] $[OUT]/pub/
next
for K:/ slot0x34Key*.bin
 cp -w $[FORPATH] $[OUT]/pub/
next
for K:/ slot0x35Key*.bin
 cp -w $[FORPATH] $[OUT]/pub/
next
for K:/ slot0x36Key*.bin
 cp -w $[FORPATH] $[OUT]/pub/
next
for K:/ slot0x37Key*.bin
 cp -w $[FORPATH] $[OUT]/pub/
next
for K:/ slot0x38Key*.bin
 cp -w $[FORPATH] $[OUT]/pub/
next
for K:/ slot0x39Key*.bin
 cp -w $[FORPATH] $[OUT]/pub/
next
for K:/ slot0x3AKey*.bin
 cp -w $[FORPATH] $[OUT]/pub/
next
for K:/ slot0x3BKey*.bin
 cp -w $[FORPATH] $[OUT]/pub/
next
for K:/ slot0x3CKey*.bin
 cp -w $[FORPATH] $[OUT]/pub/
next
for K:/ slot0x3DKey*.bin
 cp -w $[FORPATH] $[OUT]/pub/
next
for K:/ slot0x3EKey*.bin
 cp -w $[FORPATH] $[OUT]/pub/
next
for K:/ slot0x3FKey*.bin
 cp -w $[FORPATH] $[OUT]/pub/
next

# ---------------------------------------------------------------
# 2. Console-unique AES keys (slot0x04..0x2B, minus the public ones)
# ---------------------------------------------------------------
for K:/ slot0x04Key*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x05Key*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x06Key*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x07Key*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x08Key*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x09Key*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x0AKey*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x0BKey*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x0CKey*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x0DKey*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x0EKey*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x0FKey*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x10Key*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x11Key*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x12Key*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x13Key*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x14Key*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x15Key*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x16Key*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x17Key*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x19Key*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x1AKey*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x1CKey*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x1DKey*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x1EKey*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x1FKey*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x20Key*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x21Key*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x22Key*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x23Key*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x24Key*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x26Key*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x27Key*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x28Key*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x29Key*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x2AKey*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next
for K:/ slot0x2BKey*.bin
 cp -w $[FORPATH] $[OUT]/priv/
next

end

# ---------------------------------------------------------------
# 3. Console-unique material (NAND device profile) -- never upload
#    [M:] MEMORY VIRTUAL exposes boot9.bin / otp.mem / otp_dec.mem /
#    nand_cid.mem on every GodMode9 build.
# ---------------------------------------------------------------
if exist M:/otp.mem
  if not exist $[OUT]/priv/otp.mem
    cp -w M:/otp.mem $[OUT]/priv/
  end
end
if exist M:/otp_dec.mem
  if not exist $[OUT]/priv/otp_dec.mem
    cp -w M:/otp_dec.mem $[OUT]/priv/
  end
end
if exist M:/nand_cid.mem
  if not exist $[OUT]/priv/nand_cid.mem
    cp -w M:/nand_cid.mem $[OUT]/priv/
  end
end
if exist S:/private/movable.sed
  if not exist $[OUT]/priv/movable.sed
    cp -w S:/private/movable.sed $[OUT]/priv/
  end
end
if not exist $[OUT]/priv/movable.sed
  if exist 1:/private/movable.sed
    cp -w 1:/private/movable.sed $[OUT]/priv/
  end
end
if exist S:/ro/sys/seeddb.bin
  if not exist $[OUT]/priv/seeddb.bin
    cp -w S:/ro/sys/seeddb.bin $[OUT]/priv/
  end
end

# boot9.bin: source of the FIRM public moduli and required for NAND keyinit.
# It is Nintendo code, so it goes to priv/ (never publish it).
set BOOT9 "0:/__no_boot9__"
if exist M:/boot9.bin
  set BOOT9 "M:/boot9.bin"
end
if exist 0:/gm9/out/boot9.bin
  set BOOT9 "0:/gm9/out/boot9.bin"
end
if exist 0:/gm9out/boot9.bin
  set BOOT9 "0:/gm9out/boot9.bin"
end
if exist $[BOOT9]
  if not exist $[OUT]/priv/boot9.bin
    cp -w $[BOOT9] $[OUT]/priv/
  end
end

# ---------------------------------------------------------------
# 4. FIRM RSA-2048 public moduli (NAND-FIRM keyslot1)
#    boot9.bin @0xB1E0 (retail) and @0xC4E0 (dev), 256 bytes big-endian.
#    These are PUBLIC keys -- safe to publish, and exactly what the
#    handler wants in keystone\pubkey\.
# ---------------------------------------------------------------
if exist $[BOOT9]
  echo "Extracting FIRM public keys..."

  if exist $[OUT]/pubkey/retail_firm_pubkey.bin
    rm $[OUT]/pubkey/retail_firm_pubkey.bin
  end
  fdummy $[OUT]/pubkey/retail_firm_pubkey.bin 100
  fget $[BOOT9]@B1E0:7F R1
  fset $[OUT]/pubkey/retail_firm_pubkey.bin@0:7F $[R1]
  fget $[BOOT9]@B25F:7F R2
  fset $[OUT]/pubkey/retail_firm_pubkey.bin@7F:7F $[R2]
  fget $[BOOT9]@B2DE:2 R3
  fset $[OUT]/pubkey/retail_firm_pubkey.bin@FE:2 $[R3]

  if exist $[OUT]/pubkey/dev_firm_pubkey.bin
    rm $[OUT]/pubkey/dev_firm_pubkey.bin
  end
  fdummy $[OUT]/pubkey/dev_firm_pubkey.bin 100
  fget $[BOOT9]@C4E0:7F D1
  fset $[OUT]/pubkey/dev_firm_pubkey.bin@0:7F $[D1]
  fget $[BOOT9]@C55F:7F D2
  fset $[OUT]/pubkey/dev_firm_pubkey.bin@7F:7F $[D2]
  fget $[BOOT9]@C5DE:2 D3
  fset $[OUT]/pubkey/dev_firm_pubkey.bin@FE:2 $[D3]

  # pubkey.ini: without it the handler looks for boot9 / ctrdevice instead of
  # the two files above, so ship the config next to them.
  if exist $[OUT]/pubkey/pubkey.ini
    rm $[OUT]/pubkey/pubkey.ini
  end
  fdummy $[OUT]/pubkey/pubkey.ini 62
  fset $[OUT]/pubkey/pubkey.ini@0:62 5B4669726D5075624B65795D0D0A52657461696C4669726D5075624B657946696C653D72657461696C5F6669726D5F7075626B65792E62696E0D0A4465764669726D5075624B657946696C653D6465765F6669726D5F7075626B65792E62696E0D0A
else
  echo "boot9.bin not found: skipping FIRM public keys."
  echo "(Copy boot9.bin from [M:] MEMORY VIRTUAL into 0:/gm9/out first.)"
end

# ---------------------------------------------------------------
# 5. Summary
# ---------------------------------------------------------------
echo "========================"
echo "Done: $[OUT]"
echo "  pub/    = AES keys safe to publish"
echo "  priv/   = console-unique (never upload)"
echo "  pubkey/ = FIRM public keys (safe to publish)"
echo " "
echo "Put pubkey/ into  <exe dir>/keystone/pubkey/"
echo "and pub/ into      <exe dir>/keystone/ctraes_retail/"
echo "(dev dumps go to ctraes_dev; aeskeys2ctr.py does this for you)"
ask "Press A to return"
